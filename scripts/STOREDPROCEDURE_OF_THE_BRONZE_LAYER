--bulk inserting the crm_cust_info file 
PRINT '>> TRUNCATE THE TABLE  bronze.crm_cust_info'
TRUNCATE TABLE bronze.crm_cust_info ;
PRINT'BULK INSERTING THE TABLE bronze.crm_cust_info' 
