TRUNCATE TABLE bronze.crm_sales_details   ;
PRINT 'BULK INSERTING THE TABLE bronze.crm_sales_details  ' 
bulk insert bronze.crm_sales_details  from 'C:\Users\Aman\AppData\Local\Temp\37745dae-8b5c-42ce-afb9-0b20d3cf5949_sql-data-warehouse-project (1).zip.949\sql-data-warehouse-project\datasets\source_crm\sales_details.csv'
